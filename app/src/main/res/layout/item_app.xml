<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal|top"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="?android:attr/selectableItemBackgroundBorderless">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginBottom="@dimen/spacing_micro">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="@dimen/app_icon_default_size"
            android:layout_height="@dimen/app_icon_default_size"
            android:background="@drawable/bg_app_icon"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/notification_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_notification_badge"
            android:textColor="@color/notification_badge_text"
            android:textSize="@dimen/badge_text_size"
            android:textStyle="bold"
            android:paddingHorizontal="@dimen/badge_padding_horizontal"
            android:paddingVertical="@dimen/badge_padding_vertical"
            android:layout_marginEnd="@dimen/badge_margin_negative"
            android:layout_marginTop="@dimen/badge_margin_negative"
            android:visibility="gone"
            android:minWidth="@dimen/badge_min_size"
            android:minHeight="@dimen/badge_min_size"
            android:gravity="center"
            android:includeFontPadding="false"/>
    </FrameLayout>

    <TextView
        android:id="@+id/app_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal|top"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@android:color/white"
        android:shadowColor="@color/text_shadow"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textSize="@dimen/text_size_app_label" />

</LinearLayout>
