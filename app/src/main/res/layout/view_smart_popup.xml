<?xml version="1.0" encoding="utf-8"?>
<!-- [app/src/main/res/layout/view_smart_popup.xml]: Layout Smart Popup Responsif AOSP Style -->
<!-- [Penjelasan]: Menampilkan kartu aksi sistem (single pill atau multi row) dan kartu pintasan dinamis dengan panah penunjuk presisi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popup_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Indikator Panah Atas -->
    <ImageView
        android:id="@+id/arrow_up"
        android:layout_width="24dp"
        android:layout_height="10dp"
        android:src="@drawable/popup_arrow_up"
        android:visibility="gone" />

    <!-- Kontainer Kartu Mengambang Terpisah -->
    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Kartu 1: Single System Action (Pill Horizontal jika hanya 1 aksi e.g. Info Aplikasi pada System App) -->
        <LinearLayout
            android:id="@+id/card_system_action_single"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_popup_card"
            android:elevation="@dimen/popup_elevation"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:visibility="gone">

            <ImageView
                android:id="@+id/img_single_action"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info" />

            <TextView
                android:id="@+id/tv_single_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/action_app_info"
                android:textColor="@color/popup_text_primary"
                android:textSize="13sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Kartu 2: Multi System Actions (Grid Horizontal jika ada 2 atau 3 aksi: Info, Hapus, Bagikan) -->
        <LinearLayout
            android:id="@+id/card_system_actions_multi"
            android:layout_width="@dimen/popup_card_width"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_popup_card"
            android:elevation="@dimen/popup_elevation"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:visibility="gone">

            <!-- Tombol: Info aplikasi -->
            <LinearLayout
                android:id="@+id/btn_action_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_app_info"
                    android:textColor="@color/popup_text_primary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Tombol: Hapus / Uninstall -->
            <LinearLayout
                android:id="@+id/btn_action_uninstall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_uninstall" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_uninstall"
                    android:textColor="@color/popup_text_primary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Tombol: Bagikan / Share -->
            <LinearLayout
                android:id="@+id/btn_action_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_share" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/action_share"
                    android:textColor="@color/popup_text_primary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Kartu 3: Dynamic Shortcuts List -->
        <LinearLayout
            android:id="@+id/card_shortcuts_container"
            android:layout_width="@dimen/popup_card_width"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_popup_card"
            android:elevation="@dimen/popup_elevation"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- Kartu 4: Notifications Container -->
        <LinearLayout
            android:id="@+id/card_notifications_container"
            android:layout_width="@dimen/popup_card_width"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_popup_card"
            android:elevation="@dimen/popup_elevation"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tv_notification_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/popup_text_primary"
                android:textStyle="bold"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tv_notification_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/popup_text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Indikator Panah Bawah -->
    <ImageView
        android:id="@+id/arrow_down"
        android:layout_width="24dp"
        android:layout_height="10dp"
        android:src="@drawable/popup_arrow_down"
        android:visibility="gone" />

</LinearLayout>
