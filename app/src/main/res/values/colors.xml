<?xml version="1.0" encoding="utf-8"?>
<!-- [app/src/main/res/values/colors.xml]: Berkas sumber daya warna resmi -->
<!-- [Penjelasan]: Definisi seluruh warna antarmuka pengguna tanpa nilai hardcoded -->
<resources>
    <!-- [app/src/main/res/values/colors.xml]: Warna overlay dan latar belakang transparan -->
    <!-- [Penjelasan]: Warna overlay hitam transparan untuk menjaga kontras tinggi di atas wallpaper -->
    <color name="settings_overlay_bg">#CC0A0E14</color>
    
    <!-- [app/src/main/res/values/colors.xml]: Warna kartu parent dan child -->
    <!-- [Penjelasan]: Latar belakang transparan gelap untuk kartu grup pengaturan -->
    <color name="card_bg_parent">#1AFFFFFF</color>
    <color name="card_stroke_parent">#2EFFFFFF</color>
    <color name="card_bg_subparent">#14FFFFFF</color>
    <color name="card_stroke_subparent">#22FFFFFF</color>
    <color name="card_bg_child">#0DFFFFFF</color>
    <color name="card_stroke_child">#1AFFFFFF</color>
    <color name="card_bg_choice">#08FFFFFF</color>
    <color name="card_stroke_choice">#12FFFFFF</color>
    <color name="card_bg_choice_selected">#2080D8FF</color>
    <color name="card_stroke_choice_selected">#6080D8FF</color>
    <color name="accent_check">#80D8FF</color>
    <color name="text_accent">#80D8FF</color>
    
    <!-- [app/src/main/res/values/colors.xml]: Warna ikon latar belakang -->
    <!-- [Penjelasan]: Container ikon pada header parent node -->
    <color name="icon_container_bg">#26FFFFFF</color>
    <color name="icon_tint_primary">#FFFFFF</color>
    
    <!-- [app/src/main/res/values/colors.xml]: Warna teks UI -->
    <!-- [Penjelasan]: Warna teks utama, sekunder, dan bayangan teks untuk kontras tinggi -->
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B0BEC5</color>
    <color name="text_shadow">#80000000</color>
    
    <!-- [app/src/main/res/values/colors.xml]: Warna pill button dan kontrol -->
    <!-- [Penjelasan]: Latar belakang dan border tombol pill pilihan dropdown -->
    <color name="pill_bg">#33FFFFFF</color>
    <color name="pill_stroke">#4DFFFFFF</color>
    <color name="pill_text">#FFFFFF</color>

    <!-- [app/src/main/res/values/colors.xml]: Warna Popup dan Shortcut -->
    <!-- [Penjelasan]: Warna latar belakang, kartu, border, dan teks untuk Smart Popup Long-Press -->
    <color name="popup_card_background">#383838</color>
    <color name="popup_card_stroke">#4A4A4A</color>
    <color name="popup_text_primary">#F8FAFC</color>
    <color name="popup_text_secondary">#94A3B8</color>
    <color name="popup_icon_tint">#E2E8F0</color>
    <!-- [app/src/main/res/values/colors.xml]: Warna Badge Notifikasi Pintar -->
    <!-- [Penjelasan]: Warna merah terang untuk lencana notifikasi dan garis batasnya -->
    <color name="notification_badge_color">#F44336</color>
    <color name="notification_badge_stroke">#D32F2F</color>
    <color name="notification_badge_text">#FFFFFF</color>
</resources>
